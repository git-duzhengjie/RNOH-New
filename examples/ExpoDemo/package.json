{
  "name": "@rnoh-new/example-expo-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Expo compatibility demo for RNOH-New",
  "scripts": {
    "start": "react-native start",
    "bundle:harmony": "rnh-new bundle --platform harmony --entry-file ./src/index.js --bundle-output ./harmony/entry/src/main/resources/rawfile/bundle.harmony.js --assets-dest ./harmony/entry/src/main/resources/rawfile/assets",
    "codegen": "rnh-new codegen --project-root . --rnoh-module-path ./node_modules/@rnoh-new/react-native-harmony",
    "doctor": "rnh-new doctor",
    "build:harmony": "cd harmony && hvigorw assembleHap"
  },
  "dependencies": {
    "@rnoh-new/hvigor-plugin": "*",
    "@rnoh-new/react-native-harmony": "*",
    "expo": "^52.0.0",
    "expo-asset": "^11.1.7",
    "expo-constants": "^17.0.8",
    "expo-file-system": "^19.0.19",
    "expo-secure-store": "^15.0.8",
    "react": "19.0.0",
    "react-native": "0.79.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/babel-preset": "^0.79.0",
    "@react-native/community-cli-plugin": "^0.79.0",
    "@react-native/metro-babel-transformer": "^0.79.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
