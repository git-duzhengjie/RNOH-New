{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "files": [],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "oh_modules",
    "**/oh_modules",
    "dist",
    "**/dist",
    "build",
    "**/build",
    ".hvigor",
    "**/.hvigor",
    ".cxx",
    "**/.cxx",
    "packages/react-native-harmony/src/main/cpp/**",
    "**/legacy/**"
  ]
}
